# Copia este archivo a .env.local y completa los valores (no subas .env.local a GitHub).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (o la "service_role" en proyectos antiguos). SOLO servidor: se usa para crear cuentas con el código.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Google AI Studio → https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=
# Opcional: modelo a usar para escanear boletas
GEMINI_MODEL=gemini-flash-latest

# Código que deben escribir Juan Pablo y Kenny para crear su cuenta
INVITE_CODE=cambia-este-codigo
